<Window x:Class="QbReclass.App.BatchApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approve this batch"
        Height="600" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

  <DockPanel Margin="16">

    <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"
               Text="Review this batch before anything is changed" />

    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel — change nothing" IsCancel="True" MinWidth="180" Click="OnCancel" />
        <Button x:Name="ApplyButton" MinWidth="240" FontWeight="Bold" Margin="8,0,0,0" Click="OnApply" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#FFF4CE" Padding="10" Margin="0,12,0,0">
      <TextBlock x:Name="ScopeText" TextWrapping="Wrap" FontWeight="SemiBold" />
    </Border>

    <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="DetailGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
        </Grid>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>

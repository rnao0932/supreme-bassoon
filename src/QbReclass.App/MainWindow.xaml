<Window x:Class="QbReclass.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickBooks Desktop Bulk Reclassification Utility"
        Height="820" Width="1420" WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- Company identity is shown before anything else can be done (FR-001). -->
    <Border DockPanel.Dock="Top" Background="#1F3864" Padding="12,8">
      <StackPanel>
        <TextBlock Text="{Binding CompanyDisplay}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Foreground="#FFD966" Margin="0,4,0,0" FontWeight="SemiBold"
                   Text="READ-ONLY MODE — nothing in QuickBooks will be changed">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding WriteModeEnabled}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Foreground="#FF9999" Margin="0,4,0,0" FontWeight="SemiBold"
                   Text="WRITE MODE — approved batches will modify this company file">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding WriteModeEnabled}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="12,6" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Width="160" Height="14" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>

    <!-- Rule builder and filters stay visible above the grid (spec section 8). -->
    <Border DockPanel.Dock="Top" Padding="12" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
      <StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <Button Content="Connect to QuickBooks" Command="{Binding ConnectCommand}" MinWidth="160"
                  ToolTip="Connects to the company file QuickBooks currently has open." />
          <Button Content="Open simulated company" Command="{Binding ConnectSimulatedCommand}" MinWidth="170"
                  ToolTip="Explore the application against a small fake company. QuickBooks is not contacted." />
          <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
          <Border Width="1" Background="#CCCCCC" Margin="10,2" />
          <CheckBox Content="A current QuickBooks backup exists" IsChecked="{Binding BackupConfirmed}" />
          <TextBlock Text="{Binding BackupConfirmedText}" Style="{StaticResource FieldLabel}" Foreground="#666666" />
          <CheckBox Content="Enable write mode" IsChecked="{Binding WriteModeEnabled}" FontWeight="SemiBold" />
        </StackPanel>

        <Grid IsEnabled="{Binding IsConnected}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Dates" Style="{StaticResource FieldLabel}" />
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,4">
            <DatePicker SelectedDate="{Binding FromDate}" Width="130" />
            <TextBlock Text="to" Style="{StaticResource FieldLabel}" Margin="8,0" />
            <DatePicker SelectedDate="{Binding ToDate}" Width="130" />
          </StackPanel>

          <TextBlock Grid.Row="0" Grid.Column="2" Text="Types" Style="{StaticResource FieldLabel}" />
          <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
            <CheckBox Content="Credit card charges" IsChecked="{Binding IncludeCreditCardCharges}" />
            <CheckBox Content="Checks (preview only)" IsChecked="{Binding IncludeChecks}" />
          </StackPanel>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="From account" Style="{StaticResource FieldLabel}" />
          <ComboBox Grid.Row="1" Grid.Column="1" Width="300" Margin="0,0,16,4" HorizontalAlignment="Left"
                    ItemsSource="{Binding Accounts}" SelectedItem="{Binding SourceAccount}"
                    DisplayMemberPath="FullName" />

          <TextBlock Grid.Row="1" Grid.Column="2" Text="To account" Style="{StaticResource FieldLabel}" />
          <ComboBox Grid.Row="1" Grid.Column="3" Width="300" Margin="0,0,16,4" HorizontalAlignment="Left"
                    ItemsSource="{Binding Accounts}" SelectedItem="{Binding DestinationAccount}"
                    DisplayMemberPath="FullName" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Filters" Style="{StaticResource FieldLabel}" />
          <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal">
            <TextBlock Text="Payee" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding PayeeFilter, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,10,0" />
            <TextBlock Text="Memo" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding MemoFilter, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,10,0" />
            <TextBlock Text="Ref/Check #" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding ReferenceFilter, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,10,0" />
            <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding MinAmount, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,4,0" />
            <TextBlock Text="to" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding MaxAmount, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,16,0" />
            <Button Content="Preview" Command="{Binding PreviewCommand}" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Action bar -->
    <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal">
        <Button Content="Select all" Command="{Binding SelectAllCommand}" />
        <Button Content="Select none" Command="{Binding SelectNoneCommand}" />
        <Button Content="Open in QuickBooks" Command="{Binding OpenInQuickBooksCommand}" MinWidth="140" />
        <Border Width="1" Background="#CCCCCC" Margin="10,2" />
        <TextBlock Text="Batch size" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding BatchSize}" Width="55" Margin="0,0,10,0" VerticalContentAlignment="Center" />
        <CheckBox Content="Continue past isolated failures" IsChecked="{Binding ContinueOnIsolatedFailure}" />
        <Button Content="Review and approve a batch..." Command="{Binding RunBatchCommand}"
                FontWeight="SemiBold" MinWidth="200" />
        <Button Content="Stop" Command="{Binding StopCommand}" />
        <Button Content="Export audit" Command="{Binding ExportCommand}" MinWidth="110" />
      </StackPanel>
    </Border>

    <Grid Margin="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SectionHeading}"
                 Text="Preview — no change has been made to any transaction shown here." />

      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#FFF4CE" Padding="8" Margin="0,0,0,8"
              Visibility="{Binding ClearedNotice, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ClearedNotice}" TextWrapping="Wrap" />
      </Border>

      <DataGrid Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Rows}"
                SelectedItem="{Binding SelectedRow}"
                AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                IsReadOnly="False" SelectionMode="Single" GridLinesVisibility="Horizontal"
                EnableRowVirtualization="True" EnableColumnVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                HeadersVisibility="Column" RowHeaderWidth="0">

        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding CanSelect}" Value="False">
                <Setter Property="Background" Value="#F5F5F5" />
                <Setter Property="Foreground" Value="#888888" />
                <Setter Property="ToolTip" Value="{Binding Candidate.UnsupportedReason}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>

        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="34">
            <DataGridCheckBoxColumn.CellStyle>
              <Style TargetType="DataGridCell">
                <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
              </Style>
            </DataGridCheckBoxColumn.CellStyle>
          </DataGridCheckBoxColumn>
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130" IsReadOnly="True" />
          <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="90" IsReadOnly="True" />
          <DataGridTextColumn Header="Payee" Binding="{Binding Payee}" Width="160" IsReadOnly="True" />
          <DataGridTextColumn Header="Ref/Check #" Binding="{Binding Reference}" Width="90" IsReadOnly="True" />
          <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="90" IsReadOnly="True">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Current account" Binding="{Binding CurrentAccount}" Width="180" IsReadOnly="True" />
          <DataGridTextColumn Header="Proposed account" Binding="{Binding ProposedAccount}" Width="180" IsReadOnly="True" />
          <DataGridTextColumn Header="Memo" Binding="{Binding Memo}" Width="160" IsReadOnly="True" />
          <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="100" IsReadOnly="True" />
          <DataGridTextColumn Header="Reconciled" Binding="{Binding Reconciled}" Width="90" IsReadOnly="True" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>

      <GridSplitter Grid.Row="2" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

      <DockPanel Grid.Row="2" Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Transaction detail" Style="{StaticResource SectionHeading}" />
        <Border DockPanel.Dock="Bottom" Background="#EEF3FA" Padding="8" Margin="0,8,0,0">
          <TextBlock Text="{Binding TotalsText}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>
        <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding DetailText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>

<Window x:Class="QbReclass.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickBooks Desktop Bulk Reclassification Utility"
        Height="800" Width="1280" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!--
      Every control group is a label plus its input, kept together so the surrounding WrapPanel
      reflows them as units. Fixed pixel layouts were clipping dates and labels on narrower
      screens; wrapping degrades instead of truncating.
    -->
    <Style TargetType="StackPanel" x:Key="Field">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,0,18,6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <DockPanel>

    <!-- Company identity is shown before anything else can be done (FR-001). -->
    <Border DockPanel.Dock="Top" Background="#1F3864" Padding="12,8">
      <StackPanel>
        <TextBlock Text="{Binding CompanyDisplay}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                   TextWrapping="Wrap" />
        <TextBlock Foreground="#FFD966" Margin="0,4,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="READ-ONLY MODE — nothing in QuickBooks will be changed">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding WriteModeEnabled}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Foreground="#FF9999" Margin="0,4,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="WRITE MODE — approved batches will modify this company file">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding WriteModeEnabled}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="12,6" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" ToolTip="{Binding StatusText}" />
        <ProgressBar Grid.Column="1" Width="160" Height="14" IsIndeterminate="True" Margin="12,0,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>

    <!-- Action bar. Wraps rather than pushing buttons off the edge. -->
    <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
      <WrapPanel>
        <Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,8,4" />
        <Button Content="Select none" Command="{Binding SelectNoneCommand}" Margin="0,0,8,4" />
        <Button Content="Open in QuickBooks" Command="{Binding OpenInQuickBooksCommand}" MinWidth="150" Margin="0,0,16,4" />

        <StackPanel Style="{StaticResource Field}">
          <TextBlock Text="Batch size" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding BatchSize}" Width="55" VerticalContentAlignment="Center" />
        </StackPanel>

        <CheckBox Content="Continue past isolated failures" IsChecked="{Binding ContinueOnIsolatedFailure}"
                  Margin="0,0,16,4" />

        <Button Content="Review and approve a batch..." Command="{Binding RunBatchCommand}"
                FontWeight="SemiBold" MinWidth="210" Margin="0,0,8,4" />
        <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,8,4" />
        <Button Content="Export audit" Command="{Binding ExportCommand}" MinWidth="110" Margin="0,0,0,4" />
      </WrapPanel>
    </Border>

    <!-- Rule builder and filters stay visible above the grid (spec section 8). -->
    <Border DockPanel.Dock="Top" Padding="12,10" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
      <StackPanel>

        <WrapPanel Margin="0,0,0,6">
          <Button Content="Connect to QuickBooks" Command="{Binding ConnectCommand}" MinWidth="165" Margin="0,0,8,4"
                  ToolTip="Connects to the company file QuickBooks currently has open." />
          <Button Content="Open simulated company" Command="{Binding ConnectSimulatedCommand}" MinWidth="175" Margin="0,0,8,4"
                  ToolTip="Explore the application against a small fake company. QuickBooks is not contacted." />
          <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0,0,16,4" />

          <StackPanel Style="{StaticResource Field}">
            <TextBlock Text="Company file" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding CompanyFilePath, UpdateSourceTrigger=PropertyChanged}" Width="240"
                     IsEnabled="{Binding IsIdle}"
                     ToolTip="Leave blank to use whatever QuickBooks currently has open. Name a .QBW file only when QuickBooks has no file open, or to point deliberately at a restored copy." />
            <Button Content="Browse..." Command="{Binding BrowseCompanyFileCommand}" MinWidth="80" Margin="6,0,0,0" />
          </StackPanel>

          <CheckBox Content="A current QuickBooks backup exists" IsChecked="{Binding BackupConfirmed}" Margin="0,0,10,4" />
          <TextBlock Text="{Binding BackupConfirmedText}" Foreground="#666666" VerticalAlignment="Center"
                     Margin="0,0,16,4" />
          <CheckBox Content="Enable write mode" IsChecked="{Binding WriteModeEnabled}" FontWeight="SemiBold"
                    IsEnabled="{Binding CanChangeConnectionOptions}" Margin="0,0,16,4"
                    ToolTip="Set this before connecting. The session is opened read-only or writable, and that cannot change once it is open — disconnect to change it." />
          <CheckBox Content="Allow check writes (unverified)" IsChecked="{Binding EnableCheckWrites}"
                    IsEnabled="{Binding CanChangeConnectionOptions}" Margin="0,0,0,4"
                    ToolTip="Set this before connecting. Intuit's object matrix says CheckMod does not exist; run the spike with --allow-write to find out whether it does on this QuickBooks." />
        </WrapPanel>

        <WrapPanel IsEnabled="{Binding IsConnected}">

          <StackPanel Style="{StaticResource Field}">
            <TextBlock Text="Dates" Style="{StaticResource FieldLabel}" />
            <DatePicker SelectedDate="{Binding FromDate}" MinWidth="125" />
            <TextBlock Text="to" Style="{StaticResource FieldLabel}" Margin="8,0" />
            <DatePicker SelectedDate="{Binding ToDate}" MinWidth="125" />
          </StackPanel>

          <StackPanel Style="{StaticResource Field}">
            <TextBlock Text="From account" Style="{StaticResource FieldLabel}" />
            <ComboBox MinWidth="240" MaxWidth="360" ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding SourceAccount}"
                      ItemTemplate="{StaticResource AccountItem}" />
          </StackPanel>

          <StackPanel Style="{StaticResource Field}">
            <TextBlock Text="To account" Style="{StaticResource FieldLabel}" />
            <ComboBox MinWidth="240" MaxWidth="360" ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding DestinationAccount}"
                      ItemTemplate="{StaticResource AccountItem}" />
          </StackPanel>

          <StackPanel Style="{StaticResource Field}">
            <TextBlock Text="Types" Style="{StaticResource FieldLabel}" />
            <CheckBox Content="Credit card charges" IsChecked="{Binding IncludeCreditCardCharges}" />
            <CheckBox Content="Checks (preview only)" IsChecked="{Binding IncludeChecks}" />
          </StackPanel>

        </WrapPanel>

        <WrapPanel IsEnabled="{Binding IsConnected}">

          <StackPanel Style="{StaticResource Field}">
            <TextBlock Text="Payee" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding PayeeFilter, UpdateSourceTrigger=PropertyChanged}" Width="120" />
          </StackPanel>

          <StackPanel Style="{StaticResource Field}">
            <TextBlock Text="Memo" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding MemoFilter, UpdateSourceTrigger=PropertyChanged}" Width="120" />
          </StackPanel>

          <StackPanel Style="{StaticResource Field}">
            <TextBlock Text="Ref/Check #" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding ReferenceFilter, UpdateSourceTrigger=PropertyChanged}" Width="90" />
          </StackPanel>

          <StackPanel Style="{StaticResource Field}">
            <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding MinAmount, UpdateSourceTrigger=PropertyChanged}" Width="70" />
            <TextBlock Text="to" Style="{StaticResource FieldLabel}" Margin="6,0" />
            <TextBox Text="{Binding MaxAmount, UpdateSourceTrigger=PropertyChanged}" Width="70" />
          </StackPanel>

          <Button Content="Preview" Command="{Binding PreviewCommand}" FontWeight="SemiBold"
                  MinWidth="100" Margin="0,0,0,6" />
        </WrapPanel>

      </StackPanel>
    </Border>

    <Grid Margin="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="400" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="330" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SectionHeading}"
                 TextWrapping="Wrap"
                 Text="Preview — no change has been made to any transaction shown here." />

      <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding Notices}"
                    Margin="0,0,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#FFF4CE" Padding="8" Margin="0,0,0,4" BorderBrush="#E0C878" BorderThickness="1">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <DataGrid Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Rows}"
                SelectedItem="{Binding SelectedRow}"
                AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                IsReadOnly="False" SelectionMode="Single" GridLinesVisibility="Horizontal"
                EnableRowVirtualization="True" EnableColumnVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                HeadersVisibility="Column" RowHeaderWidth="0"
                HorizontalScrollBarVisibility="Auto">

        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding CanSelect}" Value="False">
                <Setter Property="Background" Value="#F5F5F5" />
                <Setter Property="Foreground" Value="#888888" />
                <Setter Property="ToolTip" Value="{Binding Candidate.UnsupportedReason}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>

        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="34">
            <DataGridCheckBoxColumn.CellStyle>
              <Style TargetType="DataGridCell">
                <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
              </Style>
            </DataGridCheckBoxColumn.CellStyle>
          </DataGridCheckBoxColumn>
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" IsReadOnly="True" />
          <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="90" IsReadOnly="True" />
          <DataGridTextColumn Header="Payee" Binding="{Binding Payee}" Width="150" IsReadOnly="True" />
          <DataGridTextColumn Header="Ref/Check #" Binding="{Binding Reference}" Width="90" IsReadOnly="True" />
          <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="90" IsReadOnly="True">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Current account" Binding="{Binding CurrentAccount}" Width="170" IsReadOnly="True" />
          <DataGridTextColumn Header="Proposed account" Binding="{Binding ProposedAccount}" Width="170" IsReadOnly="True" />
          <DataGridTextColumn Header="Memo" Binding="{Binding Memo}" Width="150" IsReadOnly="True" />
          <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="100" IsReadOnly="True" />
          <DataGridTextColumn Header="Reconciled" Binding="{Binding Reconciled}" Width="90" IsReadOnly="True" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>

      <GridSplitter Grid.Row="2" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

      <DockPanel Grid.Row="2" Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Transaction detail" Style="{StaticResource SectionHeading}" />
        <Border DockPanel.Dock="Bottom" Background="#EEF3FA" Padding="8" Margin="0,8,0,0">
          <TextBlock Text="{Binding TotalsText}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>
        <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding DetailText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
